# Copia este archivo con el nombre ".env" y rellena tu clave:
#   cp .env.example .env
# El archivo .env NUNCA se sube a git (está en .gitignore).

# Tu API key GRATUITA de Google AI Studio → https://aistudio.google.com (botón "Get API key")
GEMINI_API_KEY=

# Modelo a usar (flash es el equilibrio; flash-lite da más peticiones/día gratis)
GEMINI_MODEL=gemini-2.5-flash

# Ponlo en "true" para trabajar SIN conexión con la IA (respuestas simuladas).
# Si no hay GEMINI_API_KEY, el modo simulado se activa solo.
MOCK_LLM=false
